<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/background.css">
  <link rel="stylesheet" href="/dashboard.css">
  <title><%=user.name%></title>
</head>
<body>
  <div id = "title">
    MY DASHBOARD
  </div>
  <div id="user-info-container">
    <table>
      <tr>
        <td>Artist</td>
        <td><%=user.name%></td>
      </tr>
      <tr>
        <td>Playcount</td>
        <td><%=user.playcount%></td>
      </tr>
      <tr>
        <td>Artist Count</td>
        <td><%=user.artist_count%></td>
      </tr>
      <tr>
        <td>Track Count</td>
        <td><%=user.track_count%></td>
      </tr>
      <tr>
        <td>Album Count</td>
        <td><%=user.album_count%></td>
      </tr>
    </table>
  </div>
</body>
</html>