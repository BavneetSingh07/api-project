<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>friends</title>
  <link rel="stylesheet" href="/background.css">
  <link rel="stylesheet" href="/friends.css">
</head>
<body>
  <div id="title">
    My Friends <br>
    Total: <%= attributes.total %>
  </div>
  <div id = "table-box">
    <table >
      <% friends.forEach(friend => { %>
        <tr>
         <td>
           <a href = "/dashboard/<%=friend.name%>">
              <%= friend.name %>
           </a>
          </td>
        </tr>
      <%})%>
    </table>
  </div>
</body>
</html>