<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/background.css">
  <link rel="stylesheet" href="/top_artists.css">
  <title>My Top Artists</title>
</head>
<body>
  <div id = "title">
    My Top Tracks
  </div>
  <div id = "table-box">
    <table>
      <tr>
        <th>Artist Name</th>
        <th>Playcount</th>
      </tr>
      <%artistList.forEach(artist =>{ %>
        <tr>
          <td>
            <a href = '/artist/<%=artist.name%>'>
              <%=artist.name%>
            </a>
          </td>
          <td>
            <%=artist.playcount%>
          </td>
        </tr>
      <%})%>
    </table>
  </div>
</body>
</html>